modules = ["nodejs-22", "python-3.11", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["unzip", "imagemagick"]

[agent]
expertMode = true
integrations = ["google-sheet:1.0.0", "javascript_anthropic_ai_integrations:2.0.0"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3101
externalPort = 3002

[[ports]]
localPort = 3102
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "--import", "tsx", "server/index.ts"]
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
FEEDBACK_SPREADSHEET_ID = "1DwV5NQ8d0T0CHZfX_T9B7-sd1yVZ8y772S3ilgB41PY"

[objectStorage]
defaultBucketID = "replit-objstore-97663ec9-1d6a-41d3-b3f3-dbc9039121e1"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
